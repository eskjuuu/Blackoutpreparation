<section class="section" id="otazky"><div class="wrap faq">
  <div>
    <p class="label">Výslech</p>
    <h2 class="h2">{{ section.settings.heading }}</h2>
  </div>
  <div>
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><div class="rte">{{ block.settings.a }}</div></details>
    {%- endfor -%}
  </div>
</div></section>

{% schema %}
{
  "name": "Otázky",
  "settings": [{ "type": "text", "id": "heading", "label": "Nadpis", "default": "Časté otázky" }],
  "blocks": [
    { "type": "qa", "name": "Otázka", "settings": [
      { "type": "text", "id": "q", "label": "Otázka", "default": "Kdy mi zboží dorazí?" },
      { "type": "richtext", "id": "a", "label": "Odpověď", "default": "<p>Obvykle do 2–7 pracovních dnů.</p>" }
    ] }
  ],
  "presets": [{ "name": "Otázky", "blocks": [{ "type": "qa" }] }]
}
{% endschema %}
