<section class="section"><div class="wrap empty">
  <span class="stamp">Uzavřená zóna</span>
  <h1 class="h1">{{ shop.name }}</h1>
  <p class="lead">{{ shop.password_message | default: 'Otevíráme brzy. Připrav se.' }}</p>
  {%- form 'storefront_password', class: 'buy__row' -%}
    <div class="field"><label for="pw">Heslo</label><input id="pw" type="password" name="password" autocomplete="current-password"></div>
    <button class="btn btn--rust" type="submit" style="align-self:end">Vstoupit</button>
    {{ form.errors | default_errors }}
  {%- endform -%}
</div></section>
{% schema %}
{ "name": "Heslo" }
{% endschema %}
