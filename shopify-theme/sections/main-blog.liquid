<section class="section"><div class="wrap">
  <p class="label">Deník</p>
  <h1 class="h2">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid">
      {%- for article in blog.articles -%}
        <a class="plate card" href="{{ article.url }}">
          {%- if article.image -%}<div class="card__img">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}</div>{%- endif -%}
          <h3>{{ article.title }}</h3>
          <p class="small">{{ article.published_at | date: '%d. %m. %Y' }}</p>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div></section>
{% schema %}
{ "name": "Blog" }
{% endschema %}
