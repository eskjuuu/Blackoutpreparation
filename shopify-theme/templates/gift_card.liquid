{%- layout none -%}
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dárková karta – {{ shop.name }}</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="section"><div class="wrap empty">
    <span class="stamp">Dárková karta</span>
    <h1 class="h1">{{ gift_card.balance | money }}</h1>
    <p class="lead">Kód: <b>{{ gift_card.code | format_code }}</b></p>
    {%- if gift_card.expired -%}<p class="small">Platnost karty vypršela.</p>{%- endif -%}
    <a class="btn btn--rust" href="{{ shop.url }}">Do obchodu</a>
  </div></main>
</body>
</html>
